# ============================================================
# GEARS BACKEND ENVIRONMENT
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env
# ============================================================

NODE_ENV=development
PORT=5000

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/gears
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/gears?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gears
# Optional comma-separated DNS servers for MongoDB SRV lookup
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Cookie name for the admin session
COOKIE_NAME=gears_admin_token
# Set true only when frontend and backend are on different sites over HTTPS
COOKIE_CROSS_SITE=false

# --- URLs ---
# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
# Public base URL of THIS backend. Used to build local file URLs.
PUBLIC_API_URL=http://localhost:5000

# --- File storage ---
# "local"      -> files saved to server/uploads (default, works with no extra setup)
# "cloudinary" -> files uploaded to Cloudinary (recommended for production)
STORAGE_DRIVER=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gears

# --- Upload limits (bytes) ---
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=15728640

# --- Seed / initial admin (used only by npm run seed / create-admin) ---
SEED_ADMIN_NAME=
SEED_ADMIN_DESIGNATION=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
