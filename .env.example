# ============================================================
# GEARS FRONTEND ENVIRONMENT
# Copy to .env and adjust. Only VITE_ variables reach the browser,
# so never put a backend secret in this file.
# ============================================================

# Base URL of the GEARS API.
# Local development default is http://localhost:5000/api
# Production example: https://api.gears-lgu.com/api
VITE_API_URL=http://localhost:5000/api

# EmailJS (used by the public Contact form)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
